{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 60,
      "excludeFiles": "{legacy-python/**,tests/**,docs/**,storage/cache/**,.github/**,docker/**}"
    }
  },
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/public/assets/$1" },
    { "source": "/(.*)", "destination": "/api/index.php" }
  ]
}
